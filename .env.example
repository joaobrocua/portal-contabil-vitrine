# Supabase — copie para .env.local e preencha
# Project Settings → API no painel do Supabase

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...

# Somente no servidor. NUNCA versionar. Usada em operações administrativas
# (criar usuários, provisionar clientes).
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# Opcional. Quantos proxies confiáveis ficam na frente do app (usado para o limite
# de login por IP). Na Vercel é detectado sozinho (1). Em servidor acessado direto,
# deixe sem definir (0): o limite por IP fica desligado e vale só o por e-mail.
# TRUSTED_PROXY_HOPS=0
